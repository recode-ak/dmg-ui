{
  "name": "dmg-ui",
  "version": "0.3.0",
  "description": "Ядро UI на манифестах поверх dmg-core: сторис, экран, уведомление; каналы — отдельные подпути.",
  "license": "MIT",
  "author": "Nur",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/recode-ak/dmg-ui.git"
  },
  "engines": {
    "bun": ">=1.3.1"
  },
  "exports": {
    ".": "./packages/core/src/index.ts",
    "./chat-ui": "./packages/chat-ui/src/index.ts",
    "./chat-ui/testing": "./packages/chat-ui/testing/index.ts",
    "./graph": "./packages/core/src/graph/index.ts",
    "./server": "./packages/core/src/server/index.ts",
    "./testing": "./packages/core/testing/index.ts",
    "./testing/fixtures": "./packages/core/testing/fixtures.ts",
    "./tg-bot": "./packages/tg-bot/src/index.ts",
    "./tg-bot/testing": "./packages/tg-bot/testing/index.ts",
    "./web-ui": "./packages/web-ui/src/index.ts",
    "./web-ui/testing": "./packages/web-ui/testing/index.ts"
  },
  "peerDependencies": {
    "dmg-core": "^0.6.2",
    "valibot": "^1.5.0"
  },
  "scripts": {
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome check . --write",
    "tslint": "tsc --noEmit && tsc --noEmit -p examples/web/tsconfig.json",
    "example:tg": "bun examples/tg-bot/src/main.ts",
    "example:tg:probe": "bun examples/tg-bot/src/probe.ts",
    "example:web": "bun examples/web/src/server/main.ts",
    "smoke": "bash scripts/consumer-smoke.sh",
    "check": "bun run lint && bun run tslint && bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/bun": "latest",
    "@valibot/to-json-schema": "^1.7.1",
    "dmg-core": "git+ssh://git@github.com/recode-ak/dmg-core.git#v0.6.2",
    "grammy": "1.46.0",
    "typescript": "^7.0.2",
    "valibot": "^1.5.0"
  }
}
