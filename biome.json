{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "root": true,
  "vcs": {
    "enabled": false
  },
  "files": {
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off"
          },
          "suspicious": {
            "noExplicitAny": "off"
          },
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/**", "checks/**", "browser/**", "!**/*.test.ts"],
      "plugins": [
        "./node_modules/dmg-core/biome-plugins/code-02-class-members.grit"
      ]
    },
    {
      "includes": [
        "packages/*/src/**",
        "!**/*.test.ts",
        "!packages/example/src/runners/tg-bot/main.ts",
        "!packages/example/src/runners/tg-bot/probe.ts",
        "!packages/example/src/runners/web/server/main.ts"
      ],
      "plugins": ["./node_modules/dmg-core/biome-plugins/arc-09-no-env.grit"]
    }
  ]
}
